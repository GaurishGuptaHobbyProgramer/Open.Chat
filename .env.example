# Set APP_ENV=production and provide a stable random SECRET_KEY in deployment configuration.
# The app refuses production startup when SECRET_KEY is missing.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=chat.db
OPENCHAT_AI_ENABLED=false
OPENCHAT_DEVELOPER_USER_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
