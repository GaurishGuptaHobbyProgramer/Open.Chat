# Set APP_ENV=production and provide a stable random SECRET_KEY in deployment configuration.
# The app refuses production startup when SECRET_KEY is missing.
APP_ENV=development
# Enables local debugging; production always forces this off.
FLASK_DEBUG=1
SECRET_KEY=
DATABASE_URL=chat.db
OPENCHAT_AI_ENABLED=false
# Production: set this to the ID(s) of account(s) created in the deployed database.
# A local account or local user ID does not automatically exist on the deployed site.
OPENCHAT_DEVELOPER_USER_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Optional JSON array of WebRTC ICE servers. Use TURN credentials for restrictive networks.
CALL_ICE_SERVERS=[]
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
