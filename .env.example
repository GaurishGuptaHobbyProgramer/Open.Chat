# Local development uses SQLite at chat.db. Never commit production credentials.
# In production, set APP_ENV=production and provide a stable random SECRET_KEY.
# The app refuses production startup when SECRET_KEY is missing.
APP_ENV=development
# Enables local debugging; production always forces this off.
FLASK_DEBUG=1
SECRET_KEY=
DATABASE_URL=chat.db
# Render production uses Neon PostgreSQL's pooled URL with sslmode=require.
OPENCHAT_AI_ENABLED=false
# Optional legacy bootstrap IDs. Phone-verified developer grants are stored in the database.
OPENCHAT_DEVELOPER_USER_ID=
# Set the OTP destination to the owner's phone in E.164 format.
OPENCHAT_DEVELOPER_OTP_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Optional JSON array of WebRTC ICE servers. Use TURN credentials for restrictive networks.
CALL_ICE_SERVERS=[]
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
