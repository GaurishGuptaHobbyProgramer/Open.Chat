# Copy this file to .env.backup. Keep .env.backup and the key outside Git.
# Use Neonâ€™s direct (unpooled) URL for dump/restore, not the application pooler URL.
RESTORE_DATABASE_URL=
BACKUP_ENCRYPTION_KEY_FILE=%USERPROFILE%\OpenChatSecrets\openchat.backup.key
BACKUP_DIR=%USERPROFILE%\OpenChatBackups
BACKUP_MIRROR_DIR=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_ATTEMPTS=3
# Optional absolute paths; otherwise pg_dump and pg_restore must be on PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=
PG_DUMP_DATABASE_URL=
